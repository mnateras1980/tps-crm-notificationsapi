<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="tpsOrgAllowList" type="Tps.Crm.WhoAmI.Api.Services.OrgAllowListSection, Tps.Crm.WhoAmI.Api" />
  </configSections>
  <appSettings>
    <!-- Public .cer only (never a PFX) + its SHA-256 thumbprint pin. Blank = every assertion is rejected.
         Next is optional (rotation). Relative paths resolve against the app base directory. -->
    <add key="Assertion:CurrentCertPath" value="" />
    <add key="Assertion:CurrentSha256" value="" />
    <add key="Assertion:NextCertPath" value="" />
    <add key="Assertion:NextSha256" value="" />
  </appSettings>
  <!-- (org, machine) -> CRM organization service URL (https only). Server config only; empty = deny all.
       Example: <add org="MyOrg" machine="CRMSRV01" crmUrl="https://crm.contoso.test/MyOrg/XRMServices/2011/Organization.svc" /> -->
  <tpsOrgAllowList />
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" enableVersionHeader="false" />
    <!-- Windows auth only; anonymous callers are denied. No credentials belong in this file. -->
    <authentication mode="Windows" />
    <authorization>
      <deny users="?" />
      <allow users="*" />
    </authorization>
    <customErrors mode="RemoteOnly" />
  </system.web>
  <system.webServer>
    <!-- IIS auth providers (Windows on, Anonymous off) are set in the host applicationhost.config
         (see scripts\Set-LocalIis.ps1) because IIS Express locks that section. -->
    <validation validateIntegratedModeConfiguration="false" />
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
